import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.util.ArrayList;
import java.util.Random;

public class Generator extends JPanel implements ActionListener, KeyListener {

    // --- Timer ---
    Timer timer = new Timer(16, this);

    // --- Map ---
    int TILE_SIZE = 50;
    int MAP_ROWS  = 21;
    int MAP_COLS  = 38;

    int[][] map;
    ArrayList<Rectangle> tiles = new ArrayList<>();

    // --- Spieler ---
    Spieler spieler;

    // --- Kamera ---
    int cameraX = 0;
    int cameraY = 0;

    // --- Seed ---
    long seed;

    public Generator() {
        JFrame frame = new JFrame("Generator");

        frame.setSize(1920, 1080);
        frame.setUndecorated(true);
        frame.setExtendedState(JFrame.MAXIMIZED_BOTH);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.add(this);

        seed = System.currentTimeMillis();
        map  = generateMap(MAP_ROWS, MAP_COLS, seed);
        buildMap();

        spieler = new Spieler(tiles);
        frame.addKeyListener(spieler.keyAdapter);
        frame.addKeyListener(this);

        frame.setVisible(true);
        timer.start();
    }

    // -------------------------------------------------------
    // MAP GENERATOR
    // -------------------------------------------------------
    int[][] generateMap(int rows, int cols, long seed) {
        Random random = new Random(seed);
        int[][] newMap = new int[rows][cols];

        for (int row = rows - 3; row < rows; row++) {
            for (int col = 0; col < cols; col++) {
                newMap[row][col] = 1;
            }
        }

        int platformCount = random.nextInt(10) + 10;

        for (int i = 0; i < platformCount; i++) {
            int platformLength = random.nextInt(5) + 3;
            int row = random.nextInt(rows - 5) + 1;
            int col = random.nextInt(cols - platformLength);

            for (int j = 0; j < platformLength; j++) {
                newMap[row][col + j] = 1;
            }
        }

        return newMap;
    }

    // -------------------------------------------------------
    // BUILD MAP
    // -------------------------------------------------------
    void buildMap() {
        tiles.clear();
        for (int row = 0; row < map.length; row++) {
            for (int col = 0; col < map[row].length; col++) {
                if (map[row][col] == 1) {
                    tiles.add(new Rectangle(
                        col * TILE_SIZE,
                        row * TILE_SIZE,
                        TILE_SIZE,
                        TILE_SIZE
                    ));
                }
            }
        }
    }

    // -------------------------------------------------------
    // NEUE MAP
    // -------------------------------------------------------
    void regenerateMap() {
        seed = System.currentTimeMillis();
        map  = generateMap(MAP_ROWS, MAP_COLS, seed);
        buildMap();

        spieler.playerX   = 100;
        spieler.playerY   = 250;
        spieler.velocityY = 0;
        spieler.isJumping = false;

        System.out.println("Neue Map! Seed: " + seed);
    }

    // -------------------------------------------------------
    // GAME LOOP
    // -------------------------------------------------------
    @Override
    public void actionPerformed(ActionEvent e) {
        spieler.update();
        updateCamera();
        repaint();
    }

    // -------------------------------------------------------
    // KAMERA
    // -------------------------------------------------------
    void updateCamera() {
        int viewW = 1920;
        int viewH = 1080;

        cameraX = spieler.playerX + 25 - viewW / 2;
        cameraY = spieler.playerY + 25 - viewH / 2;

        cameraX = Math.max(0, Math.min(cameraX, MAP_COLS * TILE_SIZE - viewW));
        cameraY = Math.max(0, Math.min(cameraY, MAP_ROWS * TILE_SIZE - viewH));
    }

    // -------------------------------------------------------
    // RENDERING
    // -------------------------------------------------------
    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        Graphics2D g2 = (Graphics2D) g;

        g2.setColor(new Color(30, 30, 60));
        g2.fillRect(0, 0, getWidth(), getHeight());

        g2.translate(-cameraX, -cameraY);

        for (Rectangle tile : tiles) {
            g2.setColor(Color.GRAY);
            g2.fillRect(tile.x, tile.y, tile.width, tile.height);
            g2.setColor(Color.DARK_GRAY);
            g2.drawRect(tile.x, tile.y, tile.width, tile.height);
        }

        spieler.draw(g2);

        g2.translate(cameraX, cameraY);

        g2.setColor(Color.WHITE);
        g2.drawString("Seed: " + seed + "  |  [R] = neue Map  |  [ESC] = Beenden", 10, 20);
    }

    // -------------------------------------------------------
    // CONTROLS
    // -------------------------------------------------------
    @Override
    public void keyPressed(KeyEvent e) {
        if (e.getKeyCode() == KeyEvent.VK_ESCAPE) System.exit(0);
        if (e.getKeyCode() == KeyEvent.VK_R) regenerateMap();
    }

    @Override public void keyReleased(KeyEvent e) {}
    @Override public void keyTyped(KeyEvent e) {}

    public static void main(String[] args) {
        new Generator();
    }
}